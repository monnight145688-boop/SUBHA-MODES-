<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SUBHA MODS – AI Wingo 30s Signals & Prediction</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        /* ---------- RESET & BASE ---------- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg-deep: #06080e;
            --bg-card: rgba(255, 255, 255, 0.03);
            --border-subtle: rgba(255, 255, 255, 0.06);
            --neon-green: #10b981;
            --neon-green-glow: rgba(16, 185, 129, 0.30);
            --neon-cyan: #06b6d4;
            --neon-purple: #8b5cf6;
            --neon-amber: #f59e0b;
            --neon-red: #ef4444;
            --text-primary: #ffffff;
            --text-sub: #94a3b8;
        }

        html { scroll-behavior: smooth; }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg-deep);
            background-image:
                radial-gradient(circle at 5% 10%, rgba(16, 185, 129, 0.07) 0%, transparent 35%),
                radial-gradient(circle at 95% 20%, rgba(6, 182, 212, 0.05) 0%, transparent 35%),
                radial-gradient(circle at 50% 85%, rgba(139, 92, 246, 0.05) 0%, transparent 40%);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
            padding-bottom: 20px;
        }

        @keyframes shimmerPulse {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        @keyframes loadingGlow {
            0% { background-color: rgba(255,255,255,0.02); }
            50% { background-color: rgba(16, 185, 129, 0.08); }
            100% { background-color: rgba(255,255,255,0.02); }
        }

        /* ---------- NAVBAR ---------- */
        .navbar {
            background: rgba(6, 8, 14, 0.92);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            position: sticky;
            top: 0;
            z-index: 999;
            padding: 12px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-subtle);
        }

        .nav-logo {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 20px;
            font-weight: 900;
            background: linear-gradient(135deg, var(--neon-green), var(--neon-cyan), var(--neon-purple));
            background-size: 200% 200%;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: shimmerPulse 4s ease-in-out infinite;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .nav-logo i {
            -webkit-text-fill-color: initial;
            color: var(--neon-green);
            filter: drop-shadow(0 0 12px var(--neon-green-glow));
        }
        .nav-logo small {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 10px;
            font-weight: 600;
            -webkit-text-fill-color: var(--text-sub);
            background: rgba(255, 255, 255, 0.04);
            padding: 2px 10px;
            border-radius: 20px;
            border: 1px solid var(--border-subtle);
        }

        .btn-join-nav {
            background: linear-gradient(135deg, #0284c7, #0ea5e9);
            color: #fff;
            padding: 6px 18px;
            border-radius: 30px;
            font-size: 11px;
            font-weight: 700;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 6px;
            box-shadow: 0 4px 20px rgba(2, 132, 199, 0.30);
            transition: transform 0.15s;
        }
        .btn-join-nav:active { transform: scale(0.95); }

        /* ---------- CONTAINER ---------- */
        .container {
            max-width: 580px;
            margin: 0 auto;
            padding: 0 16px 20px;
        }

        /* ---------- SCREENSHOT CARDS ---------- */
        .screenshot-card {
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 16px;
            overflow: hidden;
            margin: 12px 0;
            position: relative;
            box-shadow: 0 8px 32px rgba(0,0,0,0.4);
        }
        
        .loading-shimmer {
            animation: loadingGlow 1.5s infinite ease-in-out;
        }

        .screenshot-card img, .feedback-card img {
            width: 100%;
            height: auto;
            display: block;
            min-height: 140px;
            background: rgba(255,255,255,0.02);
            object-fit: cover;
            cursor: pointer;
            transition: transform 0.3s, opacity 0.4s;
            opacity: 0.95;
        }
        .screenshot-card img:hover, .feedback-card img:hover {
            transform: scale(1.02);
            opacity: 1;
        }
        .screenshot-card .caption {
            padding: 10px 14px;
            font-size: 11px;
            color: var(--text-sub);
            text-align: center;
            border-top: 1px solid var(--border-subtle);
            background: rgba(0, 0, 0, 0.4);
        }

        /* ---------- FEEDBACK GALLERY GRID ---------- */
        .feedback-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            margin-top: 12px;
        }
        .feedback-card {
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
            position: relative;
        }
        .feedback-caption {
            padding: 6px 8px;
            font-size: 10px;
            font-weight: 700;
            color: var(--neon-green);
            text-align: center;
            background: rgba(0, 0, 0, 0.5);
            border-top: 1px solid var(--border-subtle);
        }

        /* ---------- HERO ---------- */
        .hero { padding: 10px 0; text-align: center; }
        .hero-features {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px 18px;
            margin: 10px 0 12px;
            font-size: 11px;
            font-weight: 700;
        }
        .hero-features span { display: flex; align-items: center; gap: 5px; }
        .hero-features .green { color: var(--neon-green); }
        .hero-features .cyan { color: var(--neon-cyan); }
        .hero-features .purple { color: var(--neon-purple); }

        .hero-desc {
            font-size: 13px;
            color: var(--text-sub);
            line-height: 1.8;
            margin-bottom: 16px;
        }
        .hero-desc strong { color: var(--neon-green); }

        /* ---------- BUTTONS ---------- */
        .btn-group {
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-width: 380px;
            margin: 0 auto 10px;
        }
        .btn-get-started {
            background: linear-gradient(135deg, var(--neon-green), var(--neon-cyan), var(--neon-purple));
            color: #022c22;
            padding: 16px 20px;
            border-radius: 14px;
            font-family: 'Space Grotesk', sans-serif;
            font-size: 16px;
            font-weight: 800;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            box-shadow: 0 10px 36px var(--neon-green-glow);
            text-decoration: none;
            transition: transform 0.2s;
        }
        .btn-get-started:active { transform: scale(0.96); }

        .btn-telegram {
            background: linear-gradient(135deg, #0284c7, #0ea5e9);
            color: #fff;
            padding: 15px 20px;
            border-radius: 14px;
            font-family: 'Space Grotesk', sans-serif;
            font-size: 15px;
            font-weight: 700;
            text-decoration: none;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            box-shadow: 0 8px 28px rgba(2, 132, 199, 0.30);
        }

        .btn-scroll {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-subtle);
            color: var(--text-sub);
            padding: 10px 20px;
            border-radius: 30px;
            font-size: 11px;
            font-weight: 600;
            margin-top: 6px;
        }

        /* ---------- SECTIONS ---------- */
        .section {
            padding: 20px 0 12px;
            border-bottom: 1px solid var(--border-subtle);
        }
        .section-pill {
            display: inline-block;
            background: rgba(16, 185, 129, 0.08);
            border: 1px solid rgba(16, 185, 129, 0.15);
            color: var(--neon-green);
            font-family: 'Space Grotesk', sans-serif;
            font-size: 9px;
            font-weight: 800;
            padding: 3px 14px;
            border-radius: 30px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 6px;
        }
        .sec-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 22px;
            font-weight: 800;
            margin-bottom: 4px;
            background: linear-gradient(135deg, #fff 60%, var(--neon-cyan));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .sec-desc {
            font-size: 12px;
            color: var(--text-sub);
            line-height: 1.7;
            margin-bottom: 12px;
        }

        /* ---------- STEP & SIGNAL CARDS ---------- */
        .step-item, .sig-item, .price-item {
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 10px;
            position: relative;
        }
        .step-badge {
            position: absolute;
            top: 14px; right: 14px;
            background: linear-gradient(135deg, var(--neon-green), var(--neon-cyan));
            color: #000;
            width: 26px; height: 26px;
            border-radius: 50%;
            font-weight: 900;
            font-size: 12px;
            display: flex; justify-content: center; align-items: center;
            box-shadow: 0 0 20px var(--neon-green-glow);
        }
        .step-title, .sig-title { font-weight: 700; font-size: 15px; display: flex; align-items: center; gap: 8px; }
        .step-desc, .sig-desc { font-size: 12px; color: var(--text-sub); margin-top: 4px; }
        
        .tag-row { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
        .tag-item {
            background: rgba(16, 185, 129, 0.07);
            color: var(--neon-green);
            font-size: 10px;
            font-weight: 700;
            padding: 2px 12px;
            border-radius: 8px;
            border: 1px solid rgba(16, 185, 129, 0.06);
        }
        .sig-badge {
            font-size: 9px;
            padding: 2px 12px;
            border-radius: 8px;
            background: rgba(6, 182, 212, 0.06);
            color: var(--neon-cyan);
            font-weight: 700;
            margin-left: auto;
            text-transform: uppercase;
            border: 1px solid rgba(6, 182, 212, 0.05);
        }

        /* ---------- TIMELINE ---------- */
        .timeline {
            position: relative;
            padding-left: 22px;
            margin-top: 6px;
        }
        .timeline::before {
            content: '';
            position: absolute;
            left: 6px; top: 6px; bottom: 6px;
            width: 2.5px;
            background: linear-gradient(180deg, var(--neon-green), var(--neon-cyan), var(--neon-purple));
            border-radius: 4px;
        }
        .tl-node { position: relative; margin-bottom: 14px; }
        .tl-node::before {
            content: '';
            position: absolute;
            left: -20px; top: 5px;
            width: 12px; height: 12px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--neon-green), var(--neon-cyan));
            box-shadow: 0 0 24px var(--neon-green-glow);
            border: 2px solid rgba(0, 0, 0, 0.4);
        }
        .tl-card {
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 14px;
            padding: 12px 16px;
        }
        .tl-card b { font-size: 14px; }
        .tl-card p { font-size: 12px; color: var(--text-sub); margin-top: 2px; }

        /* ---------- PRICING ---------- */
        .price-head { font-family: 'Space Grotesk', sans-serif; font-weight: 800; font-size: 18px; display: flex; align-items: center; gap: 8px; }
        .price-tag { font-family: 'Space Grotesk', sans-serif; font-size: 28px; font-weight: 900; color: var(--neon-green); margin: 4px 0 2px; }
        .price-tag small { font-size: 13px; font-weight: 600; color: var(--text-sub); }
        .price-desc { font-size: 12px; color: var(--text-sub); margin-bottom: 6px; }
        .price-features { font-size: 11px; color: var(--text-sub); list-style: none; margin-bottom: 10px; display: flex; flex-direction: column; gap: 4px; }
        .price-features li i { color: var(--neon-green); margin-right: 6px; }
        .price-item.featured {
            border-color: var(--neon-green);
            box-shadow: 0 0 40px var(--neon-green-glow);
        }

        /* ---------- GRID ---------- */
        .grid-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .grid-item {
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            padding: 12px 10px;
            border-radius: 14px;
            text-align: center;
            font-size: 12px;
        }
        .grid-item b { display: block; font-size: 13px; }
        .grid-item span { font-size: 10px; color: var(--text-sub); }

        /* ---------- FAQ ---------- */
        .faq-item {
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 14px;
            margin-bottom: 10px;
            overflow: hidden;
        }
        .faq-q {
            padding: 14px 16px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .faq-a {
            padding: 0 16px 14px 16px;
            font-size: 12px;
            color: var(--text-sub);
            display: none;
            line-height: 1.7;
        }

        /* ---------- THANK YOU ---------- */
        .thankyou { text-align: center; padding: 20px 0 10px; border-top: 1px solid var(--border-subtle); margin-top: 10px; }
        .thankyou h2 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 28px;
            background: linear-gradient(135deg, var(--neon-green), var(--neon-cyan));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .thankyou p { font-size: 12px; color: var(--text-sub); margin-top: 2px; }
        .thankyou .badge { margin-top: 8px; font-size: 12px; color: var(--neon-green); }
        .thankyou .team { font-size: 11px; color: var(--text-sub); margin-top: 4px; }

        /* ---------- LIGHTBOX MODAL ---------- */
        .lightbox {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.92);
            backdrop-filter: blur(12px);
            z-index: 10000;
            justify-content: center;
            align-items: center;
            padding: 16px;
        }
        .lightbox.active { display: flex; }
        .lightbox-img {
            max-width: 95%;
            max-height: 85vh;
            border-radius: 12px;
            box-shadow: 0 0 35px rgba(16, 185, 129, 0.4);
            border: 1px solid var(--border-subtle);
            object-fit: contain;
        }
        .lightbox-close {
            position: absolute;
            top: 20px; right: 20px;
            color: #fff;
            font-size: 24px;
            cursor: pointer;
            background: rgba(255,255,255,0.15);
            width: 40px; height: 40px;
            border-radius: 50%;
            display: flex; justify-content: center; align-items: center;
        }

        /* ---------- FOOTER ---------- */
        footer {
            border-top: 1px solid var(--border-subtle);
            padding-top: 20px;
            margin-top: 16px;
            text-align: center;
            font-size: 11px;
            color: var(--text-sub);
        }
        footer a { color: var(--text-sub); text-decoration: none; margin: 0 6px; }
        
        @media (max-width: 480px) {
            .container { padding: 0 12px 16px; }
            .sec-title { font-size: 19px; }
            .feedback-grid { grid-template-columns: repeat(2, 1fr); gap: 8px; }
        }
    </style>
</head>
