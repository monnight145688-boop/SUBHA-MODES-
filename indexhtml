    <!-- ====== AUTOMATIC IMGBB DIRECT LINK RESOLVER ====== -->
    <script>
        async function resolveImgBbPage(pageUrl) {
            if (!pageUrl || !pageUrl.includes('ibb.co/') || pageUrl.includes('i.ibb.co/')) {
                return pageUrl;
            }
            
            const proxies = [
                url => `https://api.allorigins.win/raw?url=${encodeURIComponent(url)}`,
                url => `https://corsproxy.io/?${encodeURIComponent(url)}`,
                url => `https://api.codetabs.com/v1/proxy?quest=${encodeURIComponent(url)}`
            ];

            for (const getProxy of proxies) {
                try {
                    const proxyUrl = getProxy(pageUrl);
                    const res = await fetch(proxyUrl, { signal: AbortSignal.timeout(3500) });
                    if (res.ok) {
                        const htmlText = await res.text();
                        const match = htmlText.match(/meta\s+property=["']og:image["']\s+content=["']([^"']+)["']/i) ||
                                      htmlText.match(/meta\s+name=["']twitter:image["']\s+content=["']([^"']+)["']/i) ||
                                      htmlText.match(/<img[^>]+src=["'](https:\/\/i\.ibb\.co\/[^"']+)["']/i);
                        if (match && match[1]) {
                            return match[1];
                        }
                    }
                } catch (e) {
                    // Try next proxy fallback
                }
            }
            return pageUrl;
        }

        async function fixAllImages() {
            const images = document.querySelectorAll('img');
            images.forEach(async (img) => {
                const src = img.getAttribute('src');
                const card = img.closest('.screenshot-card, .feedback-card');
                
                if (src && src.includes('ibb.co/') && !src.includes('i.ibb.co/')) {
                    const directUrl = await resolveImgBbPage(src);
                    if (directUrl && directUrl !== src) {
                        img.src = directUrl;
                    }
                }

                img.onload = () => {
                    if (card) card.classList.remove('loading-shimmer');
                };
                img.onerror = () => {
                    if (card) card.classList.remove('loading-shimmer');
                };

                if (img.complete && img.naturalWidth !== 0) {
                    if (card) card.classList.remove('loading-shimmer');
                }
            });
        }

        // Lightbox Popup Modal
        function initLightbox() {
            const lightbox = document.getElementById('lightbox');
            const lightboxImg = document.getElementById('lightbox-img');
            document.querySelectorAll('.screenshot-card img, .feedback-card img').forEach(img => {
                img.addEventListener('click', () => {
                    if (img.src) {
                        lightboxImg.src = img.src;
                        lightbox.classList.add('active');
                    }
                });
            });
        }

        function closeLightbox() {
            document.getElementById('lightbox').classList.remove('active');
        }

        function toggleFaq(el) {
            const ans = el.nextElementSibling;
            const icon = el.querySelector('.fa-chevron-down');
            if (ans.style.display === 'block') {
                ans.style.display = 'none';
                if (icon) icon.style.transform = 'rotate(0deg)';
            } else {
                ans.style.display = 'block';
                if (icon) icon.style.transform = 'rotate(180deg)';
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            fixAllImages();
            initLightbox();
        });
    </script>

